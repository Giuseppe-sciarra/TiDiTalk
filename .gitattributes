# Fine riga LF nel repository, chiunque faccia il commit (Windows compreso):
# gli script .sh con CRLF non partono su Linux.
* text=auto eol=lf
*.sh  text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binari: mai toccati
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
