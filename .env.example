# Copy to .env. All credentials below are intentionally empty.
SERVER_SECRET=
# Bootstrap: username:password:Display Name:admin (no colon/comma in the password).
USERS=
USERS_MODE=create
APP_NAME=Tiditalk
BASE_URL=
ANNOUNCED_IP=
CORS_ORIGINS=
BIND_ADDRESS=127.0.0.1
PORT=3010
RTC_MIN_PORT=40000
RTC_MAX_PORT=40400
TRUST_PROXY=loopback, linklocal, uniquelocal
TZ=UTC
# Fallback language for server-owned background emails (meeting invites follow the creator UI language).
DEFAULT_UI_LANGUAGE=en
TOKEN_EXPIRES_SEC=28800
GUEST_TOKEN_HOURS=24
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MIN=15
MAX_ACTIVE_ROOMS=100
DB_DIR=/app/data
DB_FILE=tdmeet.db
TURN_HOST=
TURN_REALM=
TURN_USER=
TURN_PASSWORD=
TURN_EXTERNAL_IP=
TURN_RELAY_IP=
TURN_PORT=3478
TURN_MIN_PORT=49152
TURN_MAX_PORT=49200
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
HOST_NOTIFY_EMAIL=
EXTERNAL_API_KEY=
# Legacy aliases are optional. Prefer EXTERNAL_API_KEY and BASE_URL above.
TD_EXTERNAL_API_KEY=
PUBLIC_URL=
SSL_KEY=
SSL_CERT=
UPDATE_CHECK=0
UPDATE_CHECK_HOUR=2
UPDATE_NOTIFY_EMAIL=
