# ════════════════════════════════════════════════════════════════════════════
#  Configurazione — copia questo file in .env e compila i valori.
#  Qui dentro sta solo la parte tecnica: nome, logo, colori e regole delle
#  stanze si cambiano dal pannello Impostazioni.
# ════════════════════════════════════════════════════════════════════════════

# ─── Identità di partenza ───────────────────────────────────────────────────
# Nome mostrato finché non lo cambi in Impostazioni → Brand
APP_NAME=Tiditalk
# Lingua di ripiego (email e pagine) quando il browser non ne dichiara una: it | en | fr | de
DEFAULT_UI_LANGUAGE=en
# Link al codice sorgente mostrato nella finestra "Informazioni".
# AGPL-3.0: se modifichi il software e lo offri in rete, deve puntare al TUO sorgente.
SOURCE_URL=https://github.com/Giuseppe-TD/tiditalk
TZ=Europe/Rome
# Prefisso dei nomi container (docker compose)
COMPOSE_PREFIX=tdt

# ─── Rete ───────────────────────────────────────────────────────────────────
PORT=3010
BASE_URL=https://meet.esempio.it
# IP PUBBLICO numerico del server: mediasoup non risolve i nomi a dominio
ANNOUNCED_IP=1.2.3.4
RTC_MIN_PORT=40000
RTC_MAX_PORT=40400
# Proxy fidati per l'IP reale (rate limit login). "false" se esposto senza proxy.
#TRUST_PROXY=loopback, linklocal, uniquelocal

# ─── Sicurezza (obbligatorio) ───────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=
CORS_ORIGINS=https://meet.esempio.it
TOKEN_EXPIRES_SEC=28800
GUEST_TOKEN_HOURS=24
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MIN=15
MAX_ACTIVE_ROOMS=100

# ─── Utenti ─────────────────────────────────────────────────────────────────
# Formato: utente:password:Nome visualizzato:ruolo   (ruolo = admin | host)
# Più utenti separati da virgola. La password può essere in chiaro oppure un
# hash bcrypt ($2b$...): in questo file un "$" va scritto "$$".
USERS=admin:CambiaQuestaPassword:Amministratore:admin
# create = crea solo gli utenti mancanti (default)
# sync   = .env è la fonte di verità a ogni avvio; nel pannello sono in sola lettura
USERS_MODE=create

# ─── SMTP (inviti via email) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Copia di conferma all'organizzatore (con link host diretto). Vuoto = nessuna.
HOST_NOTIFY_EMAIL=

# ─── TURN / STUN (coturn) ───────────────────────────────────────────────────
TURN_REALM=meet.esempio.it
# Se vuoto viene usato il dominio di BASE_URL
TURN_HOST=meet.esempio.it
TURN_PORT=3478
TURN_USER=tdt
TURN_PASSWORD=
# IP pubblico/IP interno della macchina (coturn): es. 1.2.3.4/10.0.0.5
TURN_EXTERNAL_IP=1.2.3.4/10.0.0.5
TURN_RELAY_IP=10.0.0.5
TURN_MIN_PORT=49152
TURN_MAX_PORT=49200

# ─── Integrazioni e manutenzione ────────────────────────────────────────────
# Chiave per l'API esterna (creazione riunioni da CRM). Vuota = API disattivata.
EXTERNAL_API_KEY=
# ─── Aggiornamenti automatici (auto-update.sh + cron) ───────────────────────
# Dove arriva il riepilogo di cosa è stato aggiornato (major/minor/patch).
UPDATE_NOTIFY_EMAIL=
# 1 = manda l'email anche i giorni in cui non c'era niente da aggiornare
UPDATE_MAIL_ALWAYS=0
# 1 = se ci sono persone collegate rimanda invece di buttarle fuori
UPDATE_SKIP_IF_BUSY=1
UPDATE_BUSY_RETRIES=3
UPDATE_BUSY_WAIT=900
# Immagini di rollback da tenere dopo la pulizia Docker (le più vecchie vengono tolte)
UPDATE_KEEP_ROLLBACK=5
# Vecchia segnalazione via email senza aggiornare: 1 per riaccenderla
UPDATE_CHECK=0
UPDATE_CHECK_HOUR=2
