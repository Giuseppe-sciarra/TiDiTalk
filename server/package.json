{
  "name": "tiditalk",
  "version": "1.9.3",
  "description": "Tiditalk — self-hosted video meetings (mediasoup SFU)",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "bundle-client": "esbuild --bundle --platform=browser --format=iife --global-name=mediasoupClient --define:global=globalThis --minify --outfile=../public/assets/js/mediasoup-client.min.js bundle-entry.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mediasoup": "^3.32.2",
    "mediasoup-client": "^3.26.0",
    "socket.io": "^4.8.4",
    "dotenv": "^18.0.10",
    "cors": "^2.8.6",
    "better-sqlite3": "^13.2.0",
    "nodemailer": "^10.6.1",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Giuseppe Sciarra — Tastiere Digitali",
  "allowScripts": {
    "better-sqlite3": true,
    "mediasoup": true,
    "esbuild": true
  }
}
